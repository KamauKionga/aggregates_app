{
  "compilerOptions": {
    "lib": ["es6", "es2017", "dom"],
    "module": "commonjs",
    "noImplicitReturns": true,
    "outDir": "lib",
    "sourceMap": true,
    "target": "es2019",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "exclude": ["node_modules"]
}
