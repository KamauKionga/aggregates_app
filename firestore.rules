// Add to your Firestore rules (adjust paths to your existing rules)
match /users/{userId} {
  allow read: if request.auth != null && request.auth.uid == userId;
  allow write: if request.auth != null && request.auth.uid == userId;

  match /preferences/notifications {
    allow read, write: if request.auth != null && request.auth.uid == userId;
  }

  match /notifications/{notifId} {
    allow create: if request.auth != null && request.auth.uid == userId; // server functions may create other users' notifications
    allow read: if request.auth != null && request.auth.uid == userId;
    allow update: if request.auth != null && request.auth.uid == userId;
    allow delete: if request.auth != null && request.auth.uid == userId;
  }
}

// Admin notifications collection
match /admin_notifications/{doc} {
  allow read: if request.auth != null && request.auth.token.admin == true;
  allow write: if request.auth != null && request.auth.token.admin == true;
}